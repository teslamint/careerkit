#!/bin/sh
# Publish de-identification guard: last local stoppable point for cherry-pick, am,
# rebase picks, annotated tags, and notes -- paths that run neither commit-msg nor
# pre-commit.
#
# Reads git's stdin quadruple (local ref, local oid, remote ref, remote oid):
#   - branch deletions (all-zero local oid) are skipped, not blocked;
#   - the fallback triggers on an all-zero remote oid or an oid absent locally, and it
#     is --not --remotes=<remote>, not the broad --remotes: a commit present on a
#     private mirror must still be scanned before it reaches the public remote;
#   - annotated tags are peeled by `git log %B`, so tag bodies are read via cat-file.
zero="0000000000000000000000000000000000000000"
fail=0
while read -r local_ref local_oid remote_ref remote_oid; do
    [ -n "$local_ref" ] || continue
    [ "$local_oid" = "$zero" ] && continue
    case "$remote_ref" in
        refs/tags/*)
            if [ "$(git cat-file -t "$local_oid" 2>/dev/null)" = "tag" ]; then
                tag_file=$(mktemp)
                git cat-file -p "$local_oid" | sed '1,/^$/d' > "$tag_file"
                uv run python -m careerkit.publish_guard --message "$tag_file" ${GUARD_LAYERS:+--layers "$GUARD_LAYERS"} || fail=1
                rm -f "$tag_file"
            fi
            # The tag publishes every commit it points at that the remote lacks; fall
            # through to the commit scan below with the peeled commit.
            local_oid=$(git rev-parse "$local_oid^{commit}" 2>/dev/null || echo "$local_oid")
            ;;
    esac
    if [ "$remote_oid" = "$zero" ] || ! git cat-file -e "$remote_oid" 2>/dev/null; then
        if ! uv run python -m careerkit.publish_guard --commits "${local_oid}" --exclude-remote "$1" ${GUARD_LAYERS:+--layers "$GUARD_LAYERS"}; then
            fail=1
        fi
    else
        uv run python -m careerkit.publish_guard --commits "${remote_oid}..${local_oid}" ${GUARD_LAYERS:+--layers "$GUARD_LAYERS"} || fail=1
    fi
done
exit "$fail"
