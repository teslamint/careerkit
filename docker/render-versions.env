# Authoritative render-environment lock inputs for PDF equivalence.
# Package/version values are intentionally human-reviewable and consumed by
# docker/render.Dockerfile and future CI drift checks.
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
PANDOC_APT_PACKAGE=pandoc
WEASYPRINT_PIP_VERSION=67.0
POPPLER_APT_PACKAGE=poppler-utils
NOTO_CJK_APT_PACKAGE=fonts-noto-cjk
PANGO_APT_PACKAGE=libpango-1.0-0
PANGOFT2_APT_PACKAGE=libpangoft2-1.0-0
PDF_RASTER_DPI=144
PDF_PIXEL_CHANNEL_THRESHOLD=8
PDF_MAX_DIFFERING_PIXEL_RATIO=0.0005
LOCAL_BASELINE_PANDOC_VERSION=3.10
LOCAL_BASELINE_WEASYPRINT_VERSION=67.0
LOCAL_BASELINE_PDFTOTEXT_VERSION=26.07.0
